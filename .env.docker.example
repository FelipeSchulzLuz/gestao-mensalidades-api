# =============================================================================
# DOCKER COMPOSE - VARIÁVEIS DE AMBIENTE (TEMPLATE)
# =============================================================================
# ⚠️  ESTE É UM TEMPLATE! NÃO CONTÉM VALORES REAIS!
#
# Para usar:
#   1. Copie este arquivo: cp .env.docker.example .env.docker
#   2. Edite .env.docker com valores reais
#   3. NUNCA commite .env.docker no Git!
#
# Gerar senhas seguras:
#   Linux/Mac: openssl rand -base64 32
#   PowerShell: [Convert]::ToBase64String((1..32 | % { Get-Random -Max 256 }))

# =============================================================================
# POSTGRESQL
# =============================================================================
DB_PASSWORD=CHANGE_ME_TO_SECURE_PASSWORD
DB_HOST=192.168.1.12
DB_PORT=54320
DB_NAME=gestao_mensalidades_dev
DB_USERNAME=gestao_app_user
DB_USER=gestao_app_user

# =============================================================================
# PGADMIN (Gerenciamento Visual do Banco)
# =============================================================================
PGADMIN_PASSWORD=CHANGE_ME_TO_SECURE_PASSWORD
PGADMIN_DEFAULT_EMAIL=your-email@example.com

# =============================================================================
# REDIS (Cache e Sessões)
# =============================================================================
REDIS_PASSWORD=CHANGE_ME_TO_SECURE_PASSWORD

# =============================================================================
# JWT (Autenticação)
# =============================================================================
# Gerar: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_TO_RANDOM_256_BIT_BASE64_STRING

# =============================================================================
# STRIPE (Pagamentos)
# =============================================================================
# Obtenha em: https://dashboard.stripe.com/apikeys
# Use test keys (sk_test_...) para desenvolvimento
STRIPE_API_KEY=sk_test_YOUR_STRIPE_SECRET_KEY_HERE
STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_STRIPE_PUBLISHABLE_KEY_HERE
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET_HERE

# =============================================================================
# FIREBASE (Autenticação Híbrida) - OPCIONAL
# =============================================================================
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY_PATH=serviceAccountKey.json

# =============================================================================
# SPRING PROFILE
# =============================================================================
SPRING_PROFILES_ACTIVE=dev

# =============================================================================
# APPLICATION
# =============================================================================
APP_PORT=8800
