# ==================================
# ENVIRONMENT VARIABLES TEMPLATE
# ==================================
# Copie este arquivo para .env e preencha com seus valores reais
# NUNCA commite o arquivo .env no Git!

# ==================================
# SPRING PROFILE
# ==================================
# Opções: dev, prod
SPRING_PROFILE=dev

# ==================================
# DATABASE CONFIGURATION
# ==================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gestao_mensalidades_dev
DB_USERNAME=postgres
DB_PASSWORD=your_database_password_here

# ==================================
# JWT CONFIGURATION
# ==================================
# IMPORTANTE: Em produção, use uma chave forte e segura (mínimo 256 bits)
# Você pode gerar uma com: openssl rand -base64 64
JWT_SECRET=your_jwt_secret_key_here_minimum_256_bits_recommended
JWT_EXPIRATION=86400000  # 24 horas em milissegundos

# ==================================
# FIREBASE AUTHENTICATION
# ==================================
# Firebase é usado para login social (Google, Facebook, etc.)
# Para configurar:
# 1. Acesse: https://console.firebase.google.com/
# 2. Crie um projeto ou use existente
# 3. Vá em: Project Settings > Service Accounts
# 4. Clique em "Generate New Private Key"
# 5. Salve o arquivo JSON em: src/main/resources/serviceAccountKey.json
# 6. ADICIONE ao .gitignore: src/main/resources/serviceAccountKey.json

# ID do projeto Firebase (obrigatório)
FIREBASE_PROJECT_ID=your-firebase-project-id

# Caminho do arquivo service account key (obrigatório)
# Opções:
#   - Caminho relativo: serviceAccountKey.json (busca em src/main/resources/)
#   - Caminho absoluto: /path/to/serviceAccountKey.json
FIREBASE_SERVICE_ACCOUNT_KEY_PATH=serviceAccountKey.json

# NOTA: Sistema Híbrido de Autenticação
# ✅ JWT: Usuários com email/senha tradicional
# ✅ Firebase: Usuários com login social (Google, Facebook, etc.)
# ✅ UnifiedAuthenticationFilter detecta automaticamente o tipo de token
# 📖 Veja docs/07-AUTENTICACAO-HIBRIDA.md para arquitetura completa

# ==================================
# STRIPE CONFIGURATION
# ==================================
# Modo TEST (desenvolvimento)
# Obtenha suas chaves em: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_your_test_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_test_publishable_key_here

# Webhook Secret (obtenha após criar webhook endpoint)
# Para teste local, execute: .\scripts\start-stripe.ps1
# O script exibirá o webhook secret automaticamente
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# NOTA IMPORTANTE: Gerenciamento de Planos
# ❌ NÃO configure IDs de produtos/prices aqui!
# ✅ Planos são gerenciados no BANCO DE DADOS via admin panel
# ✅ Admin cria/edita planos via API (POST /api/admin/plans)
# ✅ Sincronização automática com Stripe via webhooks
# 📖 Veja docs/05-PLANOS.md para arquitetura completa

# Modo LIVE (produção) - Use estas variáveis em produção
# STRIPE_SECRET_KEY=sk_live_your_live_secret_key_here
# STRIPE_PUBLISHABLE_KEY=pk_live_your_live_publishable_key_here
# STRIPE_WEBHOOK_SECRET=whsec_your_live_webhook_secret_here

# ==================================
# FRONTEND CONFIGURATION
# ==================================
FRONTEND_URL=http://localhost:3000

# ==================================
# CORS CONFIGURATION
# ==================================
# Em produção, especifique apenas domínios permitidos
# Exemplo: https://seu-dominio.com,https://app.seu-dominio.com
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ==================================
# SERVER CONFIGURATION
# ==================================
SERVER_PORT=8080

# ==================================
# SSL CONFIGURATION (Produção)
# ==================================
# Descomente e configure quando deploy em produção com HTTPS
# SSL_KEY_STORE_PATH=/path/to/keystore.p12
# SSL_KEY_STORE_PASSWORD=your_keystore_password

# ==================================
# NOTAS IMPORTANTES
# ==================================
# 
# 1. SEGURANÇA:
#    - Nunca commite este arquivo com valores reais no Git
#    - Use senhas fortes para banco de dados
#    - JWT_SECRET deve ter no mínimo 256 bits em produção
#    - Em produção, todas variáveis marcadas como OBRIGATÓRIO devem ser definidas
#
# 2. STRIPE:
#    - Use chaves de teste (sk_test_, pk_test_) em desenvolvimento
#    - Use chaves live (sk_live_, pk_live_) apenas em produção
#    - Configure webhooks no Dashboard do Stripe
#    - Para testes locais: .\scripts\start-stripe.ps1
#    - 📖 Veja docs/04-STRIPE.md para guia completo
#
# 3. BANCO DE DADOS:
#    - Em desenvolvimento, use Docker: .\scripts\start-dev.ps1
#    - PostgreSQL, pgAdmin e Redis serão iniciados automaticamente
#    - 📖 Veja docs/03-DOCKER.md para instruções completas
#    - Em produção, use um serviço gerenciado (AWS RDS, Azure Database, etc)
#
# 4. PLANOS E ASSINATURAS:
#    - ❌ NÃO configure IDs de produtos/prices no .env
#    - ✅ Planos são gerenciados no banco de dados (tabela plans)
#    - ✅ Admin cria planos via API: POST /api/admin/plans
#    - ✅ Sincronização automática com Stripe via webhooks
#    - 📖 Veja docs/05-PLANOS.md para arquitetura completa
#
# 5. PROFILES:
#    - dev: Para desenvolvimento local (logs verbosos, DDL auto-update)
#    - prod: Para produção (logs otimizados, DDL validate apenas)
